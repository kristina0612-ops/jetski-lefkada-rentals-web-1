{
	"version": 3,
	"routes": [
		{
			"src": "^/v1$",
			"headers": {
				"Location": "/"
			},
			"status": 301
		},
		{
			"src": "^/v2$",
			"headers": {
				"Location": "/"
			},
			"status": 301
		},
		{
			"src": "^/v3$",
			"headers": {
				"Location": "/"
			},
			"status": 301
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/bookings/block/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/bookings/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/bookings/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/bookings/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/calendar/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/cash-book/expense/new/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/cash-book/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/invoices/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/availability/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bookings/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bookings/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/calendar\\.ics$",
			"dest": "_render"
		},
		{
			"src": "^/api/expenses/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}