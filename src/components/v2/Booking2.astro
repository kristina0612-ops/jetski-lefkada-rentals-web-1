---
// Booking section, Nero Lefkada v2 Azure Day
// Two pieces on this section:
//   1. Calculator (instant price check, no obligation)
//   2. BookingForm (full booking: contact, licence gate, 30% deposit, 3 consents)
// Bokun embed is kept as optional drop-in for later.
//
// 2026-05-23: Water-Fun-Block aus dieser Sektion entfernt und in eigene
// WaterFun2.astro-Komponente extrahiert â€” wird jetzt direkt nach Fleet2
// gerendert, damit das Angebot prominenter sichtbar ist.
//
// HINWEIS i18n (2026-04-21): Nur die Astro-Wrapper-Texte sind dreisprachig.
// Calculator.tsx und BookingForm.tsx (React) bleiben vorerst EN, die
// werden in einem separaten Step mehrsprachig gemacht.
const BOKUN_EMBED_CODE = ""; // â† optional: paste Bokun embed to replace the form
import BookingForm from "../BookingForm.tsx";
import Calculator from "../Calculator.tsx";

type Lang = "en" | "de" | "gr";
const lang: Lang = (Astro.props.lang as Lang) ?? "en";

const COPY = {
  en: {
    eyebrow: "Book your ride",
    titleLead: "Pick a date.",
    titleAccent: "We handle the rest.",
    calcEyebrow: "Step 1 Â· Quick price check",
    calcTitle: "Try the calculator.",
    calcAccent: "no booking yet.",
    formEyebrow: "Step 2 Â· Complete booking",
    formTitle: "Ready to book?",
    formAccent: "30% deposit online.",
  },
  de: {
    eyebrow: "Buch Deine Fahrt",
    titleLead: "WÃ¤hl ein Datum.",
    titleAccent: "Den Rest machen wir.",
    calcEyebrow: "Schritt 1 Â· Schneller Preis-Check",
    calcTitle: "Probier den Rechner.",
    calcAccent: "noch keine Buchung.",
    formEyebrow: "Schritt 2 Â· Buchung abschlieÃŸen",
    formTitle: "Bereit zu buchen?",
    formAccent: "30% Anzahlung online.",
  },
  gr: {
    eyebrow: "Book your ride",
    titleLead: "Pick a date.",
    titleAccent: "We handle the rest.",
    calcEyebrow: "Step 1 Â· Quick price check",
    calcTitle: "Try the calculator.",
    calcAccent: "no booking yet.",
    formEyebrow: "Step 2 Â· Complete booking",
    formTitle: "Ready to book?",
    formAccent: "30% deposit online.",
  },
}[lang];
---

<section id="book" class="relative py-24 lg:py-32" style="background: var(--v2-ink-950);">
  <div class="mx-auto max-w-[1600px] px-6 lg:px-12">

    <div class="grid grid-cols-12 gap-6 mb-12">
      <div class="col-span-12 lg:col-span-8">
        <div class="v2-eyebrow mb-6" style="color: var(--v2-sun-400);"><span>{COPY.eyebrow}</span></div>
        <h2 class="v2-display text-5xl lg:text-[clamp(3.5rem,6vw,6.5rem)]" style="color: var(--v2-cream-50);">
          {COPY.titleLead}<br><em style="color: var(--v2-sun-400);">{COPY.titleAccent}</em>
        </h2>
      </div>
    </div>

    <!-- Price calculator: quick check without commitment -->
    <div id="calculator" class="mb-10 scroll-mt-24">
      <div class="mb-4">
        <div class="v2-eyebrow" style="color: var(--v2-sun-400);"><span>{COPY.calcEyebrow}</span></div>
        <h3 class="font-display text-2xl lg:text-3xl mt-2" style="color: var(--v2-cream-50);">
          {COPY.calcTitle} <em style="color: var(--v2-sun-400);">{COPY.calcAccent}</em>
        </h3>
      </div>
      <Calculator lang={lang} client:idle />
    </div>

    {BOKUN_EMBED_CODE ? (
      <!-- Bokun widget takes over once embed code is pasted above -->
      <div class="bokun-widget rounded-2xl overflow-hidden" set:html={BOKUN_EMBED_CODE} />
    ) : (
      <!-- Full booking form: contact, billing, licence gate, 30% deposit, 3 consents -->
      <div id="booking-form" class="scroll-mt-24">
        <div class="mb-4">
          <div class="v2-eyebrow" style="color: var(--v2-sun-400);"><span>{COPY.formEyebrow}</span></div>
          <h3 class="font-display text-2xl lg:text-3xl mt-2" style="color: var(--v2-cream-50);">
            {COPY.formTitle} <em style="color: var(--v2-sun-400);">{COPY.formAccent}</em>
          </h3>
        </div>
        <BookingForm client:idle />
      </div>
    )}

  </div>
</section>
