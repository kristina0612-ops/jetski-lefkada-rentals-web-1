---
// Layout für die Abschluss-Seite ("dauerhaft geschlossen").
//
// Bewusst NICHT LayoutBare: dort hängen Vercel Analytics, CookieBanner,
// CtaTracker und ein TouristAttraction-Schema mit Öffnungszeiten dran.
// Ein geschlossener Betrieb darf weder tracken (kein Zweck mehr, DSGVO)
// noch strukturierte Daten mit Öffnungszeiten ausliefern.
//
// Was bleibt: Titel/Description, hreflang EN<->DE, robots index (Google
// SOLL die Seite sehen, das bestätigt die Schließung im Unternehmensprofil)
// und die GSC-Verifizierung.
import "@fontsource-variable/fraunces";
import "@fontsource/instrument-sans";

interface Props {
  lang: "en" | "de";
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const SITE = "https://www.jetski-lefkada-rentals.com";
const canonical = lang === "de" ? `${SITE}/de/` : `${SITE}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Google Search Console verification (do not remove) -->
    <meta name="google-site-verification" content="SSY6upoAielJNZl8S6mN1RfOzK73xwPVmnnfVpbsbkE" />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#071d30" />
    <meta name="color-scheme" content="dark" />

    <link rel="alternate" hreflang="en" href={`${SITE}/`} />
    <link rel="alternate" hreflang="de" href={`${SITE}/de/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ffc233'/%3E%3Ctext x='50%25' y='50%25' font-family='serif' font-size='20' font-style='italic' fill='%23071d30' text-anchor='middle' dominant-baseline='central'%3EJ%3C/text%3E%3C/svg%3E"
    />

    <!-- is:global ist hier Pflicht: der Seiteninhalt kommt per <slot /> aus
         index.astro bzw. de/index.astro. Astro-scoped Styles wuerden nur
         Elemente dieses Layouts treffen und main/h1/p blieben ungestylt. -->
    <style is:global>
      :root {
        --navy: #071d30;
        --navy-soft: #0d2a44;
        --gold: #ffc233;
        --ink: #e8eef5;
        --muted: #93a7bd;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; max-width: 100%; overflow-x: hidden; }
      body {
        min-height: 100dvh;
        background: var(--navy);
        background-image:
          radial-gradient(120% 80% at 50% 0%, var(--navy-soft) 0%, var(--navy) 62%);
        color: var(--ink);
        font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.25rem;
      }
      main {
        width: min(100%, 34rem);
        /* Flex-Items schrumpfen ohne das hier nicht unter ihre min-content-
           Breite, sonst schiebt die laengste Zeile die Karte breiter als
           das Viewport. */
        min-width: 0;
        text-align: center;
      }
      .brand {
        font-size: 0.72rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--gold);
        margin: 0 0 2.5rem;
      }
      h1 {
        font-family: "Fraunces Variable", Georgia, serif;
        font-weight: 400;
        font-size: clamp(2.1rem, 7vw, 3.1rem);
        line-height: 1.12;
        letter-spacing: -0.02em;
        margin: 0 0 1.5rem;
      }
      h1 em { font-style: italic; color: var(--gold); }
      .rule {
        width: 44px; height: 2px; margin: 0 auto 2rem;
        background: linear-gradient(90deg, var(--gold), rgba(255, 194, 51, 0));
        border-radius: 1px;
      }
      p {
        font-size: 1rem;
        line-height: 1.75;
        color: var(--muted);
        margin: 0 0 1.1rem;
        /* Die Mailadresse ist ein langes Wort und darf auf schmalen Displays
           umbrechen statt die Seite breit zu ziehen. */
        overflow-wrap: anywhere;
      }
      p.lead { color: var(--ink); }
      a { color: var(--gold); text-decoration: none; }
      a:hover, a:focus-visible { text-decoration: underline; }
      footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(147, 167, 189, 0.18);
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        justify-content: center;
        font-size: 0.82rem;
        color: var(--muted);
      }
      footer a { color: var(--muted); }
      footer a:hover { color: var(--ink); }
      .legal {
        margin-top: 1.5rem;
        font-size: 0.75rem;
        line-height: 1.7;
        color: rgba(147, 167, 189, 0.7);
      }
      @media (prefers-reduced-motion: no-preference) {
        main { animation: rise 0.6s ease-out both; }
        @keyframes rise {
          from { opacity: 0; transform: translateY(8px); }
          to { opacity: 1; transform: none; }
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>